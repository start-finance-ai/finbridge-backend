BIZINFO_API_KEY=
BIZINFO_TIMEOUT_SECONDS=30

# Optional private snapshot override. The bundled synthetic demo is the fallback.
FINBRIDGE_BIZINFO_SNAPSHOT=

# OpenAI Responses API. Keep the real key only in local/deployment secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1200

# Comma-separated exact origins. Add the final Vercel origin in Railway Variables.
FINBRIDGE_CORS_ORIGINS=http://localhost:8443
